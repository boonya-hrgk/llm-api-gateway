<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 60,
    display: 'flex',
    flexDirection: 'row',
    gap: 40,
  }}>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{
        fontSize: 14,
        color: '#0EA5E9',
