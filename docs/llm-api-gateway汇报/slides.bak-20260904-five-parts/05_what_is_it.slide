          <Box key={idx} style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Text style={{ fontSize: 28 }}>{item.icon}</Text>
            <Box>
              <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F3A8A' }}>{item.title}</Text>
              <Text style={{ fontSize: 14, color: '#64748B' }}>{item.desc}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>

    <Box style={{
      width: 480,
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
