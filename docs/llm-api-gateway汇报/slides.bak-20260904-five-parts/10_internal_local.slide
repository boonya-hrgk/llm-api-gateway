<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 50,
    display: 'flex',
    flexDirection: 'row',
    gap: 32,
  }}>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
      <Text style={{
        fontSize: 14,
        color: '#0EA5E9',
        letterSpacing: 2,
        marginBottom: 8,
      }}>
        04 场景 A
      </Text>
      <Text style={{
        fontSize: 36,
        fontWeight: 'bold',
        color: '#1F3A8A',
        marginBottom: 8,
      }}>
        内网：自有大模型
      </Text>
      <Text style={{
        fontSize: 15,
        color: '#64748B',
        marginBottom: 20,
      }}>
        部署 Ollama / vLLM 在内网，敏感数据不出域
      </Text>

      <Box style={{ marginBottom: 18 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 10 }}>
          适用场景
        </Text>
        <Box style={{ display: 'flex', flexDirection: 'row', flexWrap: 'wrap', gap: 8 }}>
          {['财务/法务合同', '内部代码助手', '客户数据脱敏前处理', '私有知识库 RAG'].map((s, i) => (
            <Box key={i} style={{
              backgroundColor: '#DBEAFE',
              padding: '4px 12px',
              borderRadius: 12,
            }}>
              <Text style={{ fontSize: 13, color: '#1E40AF' }}>{s}</Text>
            </Box>
          ))}
        </Box>
      </Box>

      <Box style={{ marginBottom: 16 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 8 }}>
          部署形态
        </Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
          <Box style={{ display: 'flex', flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
            <Text style={{ fontSize: 16, color: '#10B981', fontWeight: 'bold' }}>●</Text>
            <Box>
              <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F3A8A' }}>Ollama</Text>
              <Text style={{ fontSize: 13, color: '#64748B' }}>轻量、单机/小团队，适合 7B-14B 模型</Text>
            </Box>
          </Box>
          <Box style={{ display: 'flex', flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
            <Text style={{ fontSize: 16, color: '#10B981', fontWeight: 'bold' }}>●</Text>
            <Box>
              <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F3A8A' }}>vLLM</Text>
              <Text style={{ fontSize: 13, color: '#64748B' }}>高吞吐、集群，适合 70B+ 大模型或多卡</Text>
            </Box>
          </Box>
        </Box>
      </Box>

      <Box style={{
        backgroundColor: '#F8FAFC',
        padding: 14,
        borderRadius: 8,
        borderLeft: '4px solid #1F3A8A',
      }}>
        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.6 }}>
          <span style={{ fontWeight: 'bold', color: '#1F3A8A' }}>网关侧动作：</span>
          在"上游管理"添加内网地址 → 协议标 OpenAI → 方言自动透传 → 用量照常统计
        </Text>
      </Box>
    </Box>

    <Box style={{
      width: 440,
      backgroundColor: '#F1F5F9',
      borderRadius: 12,
      padding: 16,
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
    }}>
      <Image
        src="assets/provider.png"
        style={{ width: '100%', objectFit: 'contain', borderRadius: 8 }}
      />
    </Box>
  </Box>
</Slide>
