<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 40,
    display: 'flex',
    flexDirection: 'column',
  }}>
    <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
      <Text style={{ fontSize: 14, color: '#0EA5E9', letterSpacing: 2 }}>
        05 落地
      </Text>
      <Box style={{
        backgroundColor: '#10B981',
        padding: '3px 10px',
        borderRadius: 10,
      }}>
        <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>✅ 已实现</Text>
      </Box>
    </Box>
    <Text style={{
      fontSize: 36,
      fontWeight: 'bold',
      color: '#1F3A8A',
      marginBottom: 8,
    }}>
      ③ 人员 SK 分配
    </Text>
    <Text style={{
      fontSize: 15,
      color: '#64748B',
      marginBottom: 20,
    }}>
      按人/部门发卡，权责清晰
    </Text>

    <Box style={{
      display: 'flex',
      flexDirection: 'row',
      gap: 24,
      flex: 1,
    }}>
      <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 12 }}>
        {[
          { icon: '➕', title: '创建', desc: '名称 → 选绑上游 → 设过期（外包 3 月/正式 1 年）→ 弹窗回显明文' },
          { icon: '🔄', title: '重置', desc: '丢失/泄露一键换发新钥，旧值即刻失效，名字/绑定/统计原封不动' },
          { icon: '🚫', title: '吊销', desc: '员工离职，秒级断供；彻底作废不可恢复' },
        ].map((op, i) => (
          <Box key={i} style={{
            backgroundColor: '#F8FAFC',
            padding: 16,
            borderRadius: 8,
            borderLeft: '4px solid #0EA5E9',
            display: 'flex',
            flexDirection: 'row',
            gap: 12,
            alignItems: 'flex-start',
          }}>
            <Text style={{ fontSize: 26 }}>{op.icon}</Text>
            <Box>
              <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 4 }}>
                {op.title}
              </Text>
              <Text style={{ fontSize: 13, color: '#475569', lineHeight: 1.5 }}>
                {op.desc}
              </Text>
            </Box>
          </Box>
        ))}

        <Box style={{
          backgroundColor: '#1F3A8A',
          padding: 14,
          borderRadius: 8,
          marginTop: 8,
        }}>
          <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold', marginBottom: 6 }}>
            🔐 权限分级
          </Text>
          <Box style={{ display: 'flex', flexDirection: 'row', gap: 16 }}>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 13, color: '#0EA5E9', fontWeight: 'bold' }}>管理员</Text>
              <Text style={{ fontSize: 12, color: '#CBD5E1' }}>发卡 / 重置 / 改上游</Text>
            </Box>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 13, color: '#10B981', fontWeight: 'bold' }}>查看者</Text>
              <Text style={{ fontSize: 12, color: '#CBD5E1' }}>只读统计 + 查看密钥列表</Text>
            </Box>
          </Box>
        </Box>
      </Box>

      <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 12 }}>
        <Box style={{
          backgroundColor: '#F1F5F9',
          borderRadius: 8,
          padding: 8,
          flex: 1,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
        }}>
          <Image
            src="assets/token.png"
            style={{ width: '100%', objectFit: 'contain', borderRadius: 6 }}
          />
        </Box>
        <Box style={{
          backgroundColor: '#F1F5F9',
          borderRadius: 8,
          padding: 8,
          flex: 1,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
        }}>
          <Image
            src="assets/user.png"
            style={{ width: '100%', objectFit: 'contain', borderRadius: 6 }}
          />
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
