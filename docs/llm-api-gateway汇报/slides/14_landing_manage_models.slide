<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 50,
    display: 'flex',
    flexDirection: 'row',
    gap: 32,
  }}>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
      <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
        <Text style={{ fontSize: 14, color: '#0EA5E9', letterSpacing: 2 }}>
          05 落地
        </Text>
        <Box style={{
          backgroundColor: '#10B981',
          padding: '3px 10px',
          borderRadius: 10,
        }}>
          <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>✅ 已实现</Text>
        </Box>
      </Box>
      <Text style={{
        fontSize: 36,
        fontWeight: 'bold',
        color: '#1F3A8A',
        marginBottom: 8,
      }}>
        ② 管理大模型
      </Text>
      <Text style={{
        fontSize: 16,
        color: '#475569',
        marginBottom: 24,
      }}>
        多上游 + 协议翻译 = 告别供应商绑架
      </Text>

      <Box style={{ display: 'flex', flexDirection: 'column', gap: 14, flex: 1 }}>
        {[
          {
            icon: '🌐',
            title: '同时挂任意多个上游',
            desc: '本地 Ollama / 本地 vLLM / DeepSeek 云端 / 智谱 / 任何 OpenAI 兼容端点',
          },
          {
            icon: '🔁',
            title: '协议自动翻译',
            desc: '标注 OpenAI / Anthropic 方言，网关自动完成请求/响应双向翻译',
          },
          {
            icon: '🔗',
            title: '密钥绑定上游',
            desc: '每把 sk- 独立路由到指定模型；未绑定时走默认上游',
          },
          {
            icon: '⚡',
            title: '流式 SSE 透传',
            desc: '不破坏客户端体验，长连接/打字机效果原样保留',
          },
        ].map((item, i) => (
          <Box key={i} style={{
            display: 'flex',
            flexDirection: 'row',
            gap: 14,
            alignItems: 'flex-start',
            backgroundColor: '#F8FAFC',
            padding: 14,
            borderRadius: 8,
          }}>
            <Text style={{ fontSize: 24 }}>{item.icon}</Text>
            <Box>
              <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 4 }}>
                {item.title}
              </Text>
              <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.5 }}>
                {item.desc}
              </Text>
            </Box>
          </Box>
        ))}
      </Box>

      <Box style={{
        backgroundColor: '#1F3A8A',
        padding: 14,
        borderRadius: 8,
        marginTop: 16,
      }}>
        <Text style={{ fontSize: 15, color: '#FFFFFF', textAlign: 'center', fontWeight: 'bold' }}>
          切模型 = 改 1 个后台配置，而不是改 N 个客户端
        </Text>
      </Box>
    </Box>

    <Box style={{
      width: 440,
      backgroundColor: '#F1F5F9',
