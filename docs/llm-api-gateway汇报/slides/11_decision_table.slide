<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 50,
    display: 'flex',
    flexDirection: 'column',
  }}>
    <Text style={{
      fontSize: 14,
      color: '#0EA5E9',
      letterSpacing: 2,
      marginBottom: 8,
    }}>
      04 场景
    </Text>
    <Text style={{
      fontSize: 36,
      fontWeight: 'bold',
      color: '#1F3A8A',
      marginBottom: 8,
    }}>
      什么数据放哪里？一张表说清
    </Text>
    <Text style={{
      fontSize: 14,
      color: '#64748B',
      marginBottom: 24,
    }}>
      决策原则：敏感度决定部署位置，不是能力决定
    </Text>

    <Box style={{
      border: '1px solid #E2E8F0',
      borderRadius: 12,
      overflow: 'hidden',
      flex: 1,
    }}>
      <Box style={{
        display: 'flex',
        backgroundColor: '#1F3A8A',
        padding: '14px 20px',
      }}>
        <Text style={{ flex: 1.5, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>数据类型</Text>
        <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>推荐部署</Text>
        <Text style={{ flex: 2.5, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>理由</Text>
      </Box>

      {[
        { data: '合同 / 法务 / 财务', place: '内网', color: '#1F3A8A', reason: '强合规、出域即风险' },
        { data: '客户隐私数据', place: '内网', color: '#1F3A8A', reason: '个人信息保护法' },
        { data: '内部代码 / 文档', place: '内网', color: '#1F3A8A', reason: '商业机密' },
        { data: '创意文案 / 翻译', place: '外网', color: '#0EA5E9', reason: '通用能力优先' },
        { data: '公开信息查询', place: '外网', color: '#0EA5E9', reason: '无敏感性' },
        { data: '复杂推理 / 编码', place: '视情况', color: '#F59E0B', reason: '取决于成本与隐私' },
      ].map((row, idx) => (
        <Box key={idx} style={{
          display: 'flex',
          padding: '12px 20px',
          backgroundColor: idx % 2 === 0 ? '#F8FAFC' : '#FFFFFF',
          alignItems: 'center',
        }}>
          <Text style={{ flex: 1.5, fontSize: 15, color: '#1F3A8A', fontWeight: 'bold' }}>{row.data}</Text>
          <Box style={{ flex: 1 }}>
            <Box style={{
              display: 'inline-block',
              backgroundColor: row.color,
              padding: '4px 14px',
              borderRadius: 16,
            }}>
              <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold' }}>{row.place}</Text>
            </Box>
          </Box>
          <Text style={{ flex: 2.5, fontSize: 14, color: '#475569' }}>{row.reason}</Text>
        </Box>
      ))}
    </Box>

    <Text style={{
      fontSize: 20,
      fontWeight: 'bold',
      color: '#0EA5E9',
      textAlign: 'center',
      marginTop: 24,
    }}>
      敏感度决定部署位置，不是能力决定
    </Text>
  </Box>
</Slide>
