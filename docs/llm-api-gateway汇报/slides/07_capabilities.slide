<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 40,
    display: 'flex',
    flexDirection: 'row',
    gap: 28,
  }}>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
      <Text style={{
        fontSize: 13,
        color: '#0EA5E9',
        letterSpacing: 2,
        marginBottom: 6,
      }}>
        03 能力
      </Text>
      <Text style={{
        fontSize: 30,
        fontWeight: 'bold',
        color: '#1F3A8A',
        marginBottom: 18,
      }}>
        4 大能力把"秩序"建起来
      </Text>

      <Box style={{
        display: 'grid',
        gridTemplateColumns: '1fr 1fr',
        gap: 12,
        flex: 1,
      }}>
        {[
          { icon: '🔀', title: '多上游路由', desc: '一个网关背后挂任意多个模型服务' },
          { icon: '🔑', title: '密钥管理', desc: '按人发卡、明文回显、丢失一键重置' },
          { icon: '📊', title: '用量统计', desc: '日/周/月 + 缓存命中，月底出报表' },
          { icon: '💬', title: '内置对话', desc: '员工日常问答不需去外部网页' },
        ].map((item, idx) => (
          <Box key={idx} style={{
            backgroundColor: '#F8FAFC',
            padding: 14,
            borderRadius: 10,
            display: 'flex',
            flexDirection: 'column',
            gap: 4,
          }}>
            <Text style={{ fontSize: 26 }}>{item.icon}</Text>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1F3A8A' }}>
              {item.title}
            </Text>
            <Text style={{ fontSize: 12, color: '#475569', lineHeight: 1.4 }}>
              {item.desc}
            </Text>
          </Box>
        ))}
      </Box>
    </Box>

    <Box style={{
      width: 420,
      backgroundColor: '#F1F5F9',
      borderRadius: 10,
      padding: 12,
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
    }}>
      <Image
        src="assets/overview.png"
        style={{ width: '100%', objectFit: 'contain', borderRadius: 6 }}
      />
    </Box>
