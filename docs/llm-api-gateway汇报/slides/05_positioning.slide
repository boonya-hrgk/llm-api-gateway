<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 60,
    display: 'flex',
    flexDirection: 'column',
  }}>
    <Text style={{
      fontSize: 14,
      color: '#0EA5E9',
      letterSpacing: 2,
      marginBottom: 8,
    }}>
      02 定位
    </Text>
    <Text style={{
      fontSize: 40,
      fontWeight: 'bold',
      color: '#1F3A8A',
      marginBottom: 8,
    }}>
      我们的选择：自用网关
    </Text>
    <Text style={{
      fontSize: 16,
      color: '#64748B',
      marginBottom: 40,
    }}>
      不卖算力，只做"管好自己人怎么用 AI"
    </Text>

    <Box style={{
      display: 'flex',
      flexDirection: 'row',
      gap: 32,
      flex: 1,
    }}>
      <Box style={{
        flex: 1,
        backgroundColor: '#F8FAFC',
        padding: 28,
        borderRadius: 12,
      }}>
        <Text style={{
          fontSize: 14,
          color: '#94A3B8',
          letterSpacing: 2,
          marginBottom: 12,
        }}>
          我们 不 做
        </Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          {[
            { icon: '✗', label: '不做转售 API', desc: '红海 + 合规风险' },
            { icon: '✗', label: '不做 token 商城', desc: '不与硅基流动/官方拼价' },
            { icon: '✗', label: '不做算力平台', desc: 'GPU 投入产出风险高' },
          ].map((item, idx) => (
            <Box key={idx} style={{ display: 'flex', flexDirection: 'row', alignItems: 'flex-start', gap: 12 }}>
              <Text style={{ fontSize: 24, color: '#DC2626', fontWeight: 'bold' }}>{item.icon}</Text>
              <Box>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F3A8A' }}>{item.label}</Text>
                <Text style={{ fontSize: 14, color: '#64748B' }}>{item.desc}</Text>
              </Box>
            </Box>
          ))}
        </Box>
      </Box>

      <Box style={{
        flex: 1,
        backgroundColor: '#1F3A8A',
        padding: 28,
        borderRadius: 12,
      }}>
        <Text style={{
          fontSize: 14,
          color: '#0EA5E9',
          letterSpacing: 2,
          marginBottom: 12,
        }}>
          我们 做
        </Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          {[
            { icon: '✓', label: '内网统一出口', desc: '员工只认一个地址' },
            { icon: '✓', label: '按人/部门发卡', desc: 'sk- 密钥独立鉴权' },
            { icon: '✓', label: '用量审计与权限', desc: '日/周/月 + 缓存命中' },
            { icon: '✓', label: '自有 + 云端模型并存', desc: '敏感度决定部署位置' },
          ].map((item, idx) => (
            <Box key={idx} style={{ display: 'flex', flexDirection: 'row', alignItems: 'flex-start', gap: 12 }}>
              <Text style={{ fontSize: 24, color: '#10B981', fontWeight: 'bold' }}>{item.icon}</Text>
              <Box>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>{item.label}</Text>
                <Text style={{ fontSize: 14, color: '#CBD5E1' }}>{item.desc}</Text>
              </Box>
            </Box>
          ))}
        </Box>
      </Box>
    </Box>

    <Text style={{
      fontSize: 28,
      fontWeight: 'bold',
      color: '#0EA5E9',
      textAlign: 'center',
