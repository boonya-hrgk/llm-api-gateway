<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 50,
    display: 'flex',
    flexDirection: 'column',
  }}>
    <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
      <Text style={{ fontSize: 14, color: '#0EA5E9', letterSpacing: 2 }}>
        05 落地
      </Text>
      <Box style={{
        backgroundColor: '#2563EB',
        padding: '3px 10px',
        borderRadius: 10,
      }}>
        <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>🔌 集成说明</Text>
      </Box>
    </Box>
    <Text style={{
      fontSize: 36,
      fontWeight: 'bold',
      color: '#1F3A8A',
      marginBottom: 8,
    }}>
      ④ CC Switch 集成
    </Text>
    <Text style={{
      fontSize: 15,
      color: '#64748B',
      marginBottom: 24,
    }}>
      员工 IDE 零改造，CC Switch 一键指向网关
    </Text>

    <Box style={{ display: 'flex', flexDirection: 'row', gap: 32, flex: 1 }}>
      <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 16 }}>
        <Box style={{
          backgroundColor: '#F8FAFC',
          padding: 18,
          borderRadius: 8,
          borderLeft: '4px solid #2563EB',
        }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 6 }}>
            什么是 CC Switch
          </Text>
          <Text style={{ fontSize: 13, color: '#475569', lineHeight: 1.5 }}>
            Claude Code / Cursor 等 AI IDE 的 provider 切换插件（外部工具，不在项目代码内）。
          </Text>
        </Box>

        <Box>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 12 }}>
            4 步接入网关
          </Text>
          <Box style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
            {[
              { num: '1', text: '在 CC Switch 添加一个 Provider' },
              { num: '2', text: 'Base URL 填 网关内网地址 + /v1' },
              { num: '3', text: 'API Key 填网关发的 sk-xxx' },
              { num: '4', text: '模型名填上游已配置的可用模型' },
            ].map((s, i) => (
              <Box key={i} style={{ display: 'flex', flexDirection: 'row', gap: 12, alignItems: 'center' }}>
                <Box style={{
                  width: 28,
                  height: 28,
                  backgroundColor: '#0EA5E9',
                  borderRadius: 14,
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                }}>
                  <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>{s.num}</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#475569' }}>{s.text}</Text>
              </Box>
            ))}
          </Box>
        </Box>
      </Box>

      <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 12 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 4 }}>
          接入示意
        </Text>
        <Box style={{
          backgroundColor: '#0F172A',
          padding: 18,
          borderRadius: 8,
        }}>
          <Text style={{ fontSize: 11, color: '#94A3B8', fontFamily: 'monospace', marginBottom: 10 }}>
            // CC Switch Provider Config
          </Text>
          <Text style={{ fontSize: 12, color: '#E2E8F0', fontFamily: 'monospace', lineHeight: 1.7 }}>
            <span style={{ color: '#0EA5E9' }}>name</span>: <span style={{ color: '#10B981' }}>"公司内网网关"</span>{"\n"}
            <span style={{ color: '#0EA5E9' }}>baseURL</span>: <span style={{ color: '#10B981' }}>"http://gateway.内网:9000/v1"</span>{"\n"}
            <span style={{ color: '#0EA5E9' }}>apiKey</span>: <span style={{ color: '#10B981' }}>"sk-xxx（网关发的）"</span>{"\n"}
            <span style={{ color: '#0EA5E9' }}>models</span>: ["deepseek-chat", "qwen3-8b", ...]
          </Text>
        </Box>

        <Box style={{
          backgroundColor: '#ECFDF5',
          padding: 14,
          borderRadius: 8,
          borderLeft: '4px solid #10B981',
        }}>
          <Text style={{ fontSize: 14, color: '#065F46', fontWeight: 'bold', marginBottom: 6 }}>
            带来的好处
          </Text>
          <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 13, color: '#065F46' }}>• 员工本地 IDE 切模型无需改代码</Text>
            <Text style={{ fontSize: 13, color: '#065F46' }}>• 真实上游 API Key 不下发到员工电脑</Text>
            <Text style={{ fontSize: 13, color: '#065F46' }}>• 网关统一记账、可审计</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
