<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 50,
    display: 'flex',
    flexDirection: 'row',
    gap: 32,
  }}>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
      <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
        <Text style={{ fontSize: 14, color: '#0EA5E9', letterSpacing: 2 }}>
          05 落地
        </Text>
        <Box style={{
          backgroundColor: '#10B981',
          padding: '3px 10px',
          borderRadius: 10,
        }}>
          <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>✅ 已实现</Text>
        </Box>
      </Box>
      <Text style={{
        fontSize: 36,
        fontWeight: 'bold',
        color: '#1F3A8A',
        marginBottom: 8,
      }}>
        ① 环境部署
      </Text>
      <Text style={{
        fontSize: 16,
        color: '#475569',
        marginBottom: 24,
      }}>
        5 分钟从零到可用，三种部署方式任选
      </Text>

      <Box style={{ display: 'flex', flexDirection: 'column', gap: 16, flex: 1 }}>
        <Box style={{
          backgroundColor: '#F8FAFC',
          padding: 16,
          borderRadius: 8,
          borderLeft: '4px solid #1F3A8A',
        }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 8 }}>
            🐳 Docker（推荐）
          </Text>
          <Box style={{ backgroundColor: '#0F172A', padding: 12, borderRadius: 6 }}>
            <Text style={{ fontSize: 11, color: '#E2E8F0', fontFamily: 'monospace', lineHeight: 1.6 }}>
              <span style={{ color: '#0EA5E9' }}>docker</span> build -t llm-api-gateway .{"\n"}
              <span style={{ color: '#0EA5E9' }}>docker</span> run -d -p 9000:9000 \{"\n"}
              {"  "}-e MASTER_KEY=<span style={{ color: '#10B981' }}>你的密码</span> \{"\n"}
              {"  "}-v "$PWD/data:/app/data" llm-api-gateway
            </Text>
          </Box>
        </Box>

        <Box style={{
          backgroundColor: '#F8FAFC',
          padding: 16,
          borderRadius: 8,
          borderLeft: '4px solid #0EA5E9',
        }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 8 }}>
            💻 裸机（最简单）
          </Text>
          <Box style={{ backgroundColor: '#0F172A', padding: 12, borderRadius: 6 }}>
            <Text style={{ fontSize: 11, color: '#E2E8F0', fontFamily: 'monospace', lineHeight: 1.6 }}>
              <span style={{ color: '#0EA5E9' }}>cd</span> proxy{"\n"}
              pip install -r requirements.txt{"\n"}
              <span style={{ color: '#0EA5E9' }}>python</span> main.py
            </Text>
          </Box>
        </Box>

        <Box style={{
          backgroundColor: '#F8FAFC',
          padding: 16,
          borderRadius: 8,
          borderLeft: '4px solid #475569',
        }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 6 }}>
            📦 离线部署包
          </Text>
          <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.5 }}>
            内网无外网场景：pip 依赖本地化、前端 vendor 本地打包，断网环境照常跑
          </Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
