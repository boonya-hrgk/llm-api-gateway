<Slide>
  <Box style={{
    width: '100%',
    height: '100%',
    backgroundColor: '#FFFFFF',
    padding: 50,
    display: 'flex',
    flexDirection: 'row',
    gap: 32,
  }}>
    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
      <Text style={{
        fontSize: 14,
        color: '#0EA5E9',
        letterSpacing: 2,
        marginBottom: 8,
      }}>
        04 场景 B
      </Text>
      <Text style={{
        fontSize: 36,
        fontWeight: 'bold',
        color: '#1F3A8A',
        marginBottom: 8,
      }}>
        外网：云端大模型
      </Text>
      <Text style={{
        fontSize: 15,
        color: '#64748B',
        marginBottom: 20,
      }}>
        走网关接入云端 API，能力封顶
      </Text>

      <Box style={{ marginBottom: 18 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 10 }}>
          适用场景
        </Text>
        <Box style={{ display: 'flex', flexDirection: 'row', flexWrap: 'wrap', gap: 8 }}>
          {['通用问答', '翻译/写作', '复杂推理', '视觉/多模态'].map((s, i) => (
            <Box key={i} style={{
              backgroundColor: '#E0F2FE',
              padding: '4px 12px',
              borderRadius: 12,
            }}>
              <Text style={{ fontSize: 13, color: '#075985' }}>{s}</Text>
            </Box>
          ))}
        </Box>
      </Box>

      <Box style={{ marginBottom: 16 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F3A8A', marginBottom: 8 }}>
          接入厂商
        </Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          {[
            { name: 'DeepSeek', desc: '中文强 / 价格低' },
            { name: '阿里百炼 / Qwen Plus', desc: '中文 / 企业级 SLA' },
            { name: '智谱 GLM-4', desc: '推理强' },
            { name: '其他 OpenAI 兼容端点', desc: '百川 / MiniMax 等' },
          ].map((v, i) => (
            <Box key={i} style={{ display: 'flex', flexDirection: 'row', gap: 8, alignItems: 'center' }}>
              <Text style={{ fontSize: 14, color: '#0EA5E9' }}>◆</Text>
              <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1F3A8A' }}>{v.name}</Text>
              <Text style={{ fontSize: 13, color: '#64748B' }}>— {v.desc}</Text>
            </Box>
          ))}
        </Box>
      </Box>

      <Box style={{
        backgroundColor: '#F8FAFC',
        padding: 14,
        borderRadius: 8,
        borderLeft: '4px solid #0EA5E9',
      }}>
        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.6 }}>
          <span style={{ fontWeight: 'bold', color: '#1F3A8A' }}>网关侧动作：</span>
          厂商 API Key 只存网关，<span style={{ color: '#DC2626', fontWeight: 'bold' }}>员工拿不到</span>；可配置"流式自动补 include_usage"以保证 Ollama 这类上游的用量也被正确采集。
        </Text>
      </Box>
    </Box>

    <Box style={{
      width: 440,
      backgroundColor: '#F1F5F9',
      borderRadius: 12,
      padding: 16,
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
    }}>
      <Image
        src="assets/statistics.png"
        style={{ width: '100%', objectFit: 'contain', borderRadius: 8 }}
      />
    </Box>
  </Box>
</Slide>
