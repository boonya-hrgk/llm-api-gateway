# ===== 必改配置 =====
# 上游大模型服务地址（vLLM / Ollama / Xinference 等 OpenAI 兼容服务）
VLLM_TARGET_URL=http://127.0.0.1:8000

# ===== JWT 配置 =====
# JWT 签名密钥（生产环境必须设置，否则每次启动随机生成，重启后登录失效）
# JWT_SECRET=your-secret-key-here-change-me

# JWT 过期时间（小时），默认 24
# JWT_EXPIRE_HOURS=24

# ===== 默认管理员账号 =====
# 首次启动自动创建的默认管理员用户名
# DEFAULT_ADMIN_USERNAME=admin

# 首次启动自动创建的默认管理员密码（请登录后及时修改）
# DEFAULT_ADMIN_PASSWORD=hrgk@admin

# ===== 可选配置 =====
# 若上游服务自身开启了 api-key 鉴权，填这里
# UPSTREAM_API_KEY=

# 监听地址和端口
# PROXY_HOST=0.0.0.0
# PROXY_PORT=9000

# SQLite 数据库路径
# DB_PATH=data/keys.db
